# ══════════════════════════════════════════════════════════════════════════════
#  Movie Review System — Environment Variables
#  Copy this file to .env and fill in your values before starting the server.
#  Never commit the real .env file to version control.
# ══════════════════════════════════════════════════════════════════════════════


# ─── Application ──────────────────────────────────────────────────────────────
# Port the Express server listens on.
# Optional — defaults to 5000.
PORT=5000

# Runtime environment. Controls logging verbosity, cookie security, and
# error-response detail. Use "production" in deployed environments.
NODE_ENV=development


# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted).
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/movie-review
MONGO_URI=your_mongodb_connection_string


# ─── Authentication (JWT) ─────────────────────────────────────────────────────
# Secret used to sign short-lived access tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=generate_a_secure_random_string_min_64_chars

# Secret used to sign long-lived refresh tokens. Must differ from ACCESS_TOKEN_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
REFRESH_TOKEN_SECRET=generate_a_different_secure_random_string_min_64_chars

# Lifetime of access tokens. Optional — defaults to 15m.
ACCESS_TOKEN_EXPIRES=15m

# Lifetime of refresh tokens. Optional — defaults to 7d.
REFRESH_TOKEN_EXPIRES=7d


# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection URL used for caching (top-rated / trending) and BullMQ queues.
# Optional — defaults to redis://localhost:6379 (local Redis).
# For Upstash: rediss://<username>:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379


# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Credentials for movie poster and user avatar uploads.
# Obtain from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# SMTP server settings for sending welcome emails, password-reset links,
# and new-review notifications via Nodemailer.
# For Gmail: use smtp.gmail.com on port 587 with an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_address@gmail.com
SMTP_PASS=your_smtp_app_password


# ─── External APIs ────────────────────────────────────────────────────────────
# TMDB (The Movie Database) key — only required when running the import script.
#   npm run import-movies
# Supports both formats:
#   - API Key v3 (32-char hex) found at https://www.themoviedb.org/settings/api
#   - Read Access Token (long JWT) from the same settings page
# Optional — not needed for normal server operation.
TMDB_API_KEY=your_tmdb_api_key_or_read_access_token


# ─── Frontend ─────────────────────────────────────────────────────────────────
# Origin URL of the React client. Used for CORS policy and password-reset email links.
# Development default shown below; change to your deployed domain in production.
CLIENT_URL=http://localhost:5173
