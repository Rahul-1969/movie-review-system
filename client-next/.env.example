# ══════════════════════════════════════════════════════════════════════════════
#  Movie Review System — Next.js Client Environment Variables
#  Copy to .env.local for local development, or configure in your hosting provider
#  (e.g., Vercel) Environment Variables settings for staging and production.
# ══════════════════════════════════════════════════════════════════════════════

# ─── API Base URL ─────────────────────────────────────────────────────────────
# Base URL for backend API requests (both client-side Axios and server-side fetch)
# Local development default:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
#
# Staging example:
# NEXT_PUBLIC_API_URL=https://movie-review-api-staging.onrender.com/api
#
# Production example:
# NEXT_PUBLIC_API_URL=https://movie-review-api-sx0j.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
